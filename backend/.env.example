# 应用配置
APP_NAME=非遗数字生命互动引擎
APP_VERSION=1.0.0
DEBUG=True

# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./heritage.db

# CORS：.env 里的 CORS_ORIGINS 会「整表替换」代码默认值，若漏写公网 Origin 会 curl 预检报 Disallowed CORS origin。代码会把作业机 182.92.76.74:3000/8000 强制并入（CORS_ORIGINS_MERGE_DEFAULTS=true，默认）。
# 默认还会启用「内置 DEMO 正则」(http/https + 主机 + 可选端口)。
# 若浏览器仍报预检无 Access-Control-Allow-Origin：① 改完 .env 必须重启 uvicorn；② 若 8000 前有 Nginx，须把 OPTIONS 转发到本服务或自己在 Nginx 回 CORS 头，勿对 OPTIONS 直接 204/403 且无 CORS 头；③ .env 里 CORS_ORIGINS 须为合法 JSON、英文逗号；④ 勿在 .env 写死错误的 CORS_ORIGIN_REGEX 盖掉内置正则。
# 上线收紧：CORS_STRICT=true，并只保留可信 Origin。
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173","http://182.92.76.74:8000","http://182.92.76.74:3000"]
# CORS_STRICT=false
# 可选：自定义正则（非空则替代内置 DEMO 正则）
# CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1|[0-9]{1,3}(\.[0-9]{1,3}){3}):3000$

# JWT 配置（生产环境请修改）
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========== AI API 配置（重要）==========
# 以下配置决定系统是否使用真实的 AI 服务
# 如果留空，系统将使用模拟数据（mock）降级运行

# 阿里云通义千问 API（推荐）
# 获取方式：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here

# OpenAI API（备选）
# 获取方式：https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ========== 可选配置 ==========

# Neo4j 图数据库（如果不配置，使用 SQLite）
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-password

# Redis 缓存（可选）
# REDIS_URL=redis://localhost:6379

# Milvus 向量数据库（如果不配置，使用本地检索）
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
